# Aira server configuration. Copy to .env and edit the values below.
# Everything here is read from .env by the backend only; the key never reaches the browser.
# Put these settings in .env, not in your shell: a base URL or transport that exists
# only in the shell is ignored for direct OpenAI.

# --- Direct OpenAI (default): official endpoint, Responses API ---
# Paste your OpenAI API key after the equals sign.
OPENAI_API_KEY=
# Any OpenAI model that supports structured outputs (json_schema) works.
AIRA_MODEL=gpt-4o

# --- Alternative: Google Gemini through its OpenAI-compatible endpoint ---
# Uncomment all four lines. They come after the block above, so they replace it.
# The openai_compatible backend uses chat completions and sends no gateway-only fields.
# OPENAI_API_KEY=<Gemini API key>
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AIRA_LLM_BACKEND=openai_compatible
# AIRA_MODEL=gemini-2.5-flash

# --- Other OpenAI-compatible endpoints (Ollama, vLLM, Groq, DeepSeek, OpenRouter) ---
# Set OPENAI_BASE_URL, AIRA_MODEL, and AIRA_LLM_BACKEND=openai_compatible the same way.
# Local endpoints without authentication may leave OPENAI_API_KEY empty.
# A LiteLLM proxy uses AIRA_LLM_BACKEND=litellm (it also receives a per-request timeout field).

# --- Recommended deadlines and output budget for real models ---
# Defaults are 30 s per request, 65 s per adapter stage, 90 s per workflow stage, and
# 4096 output tokens. These values leave room for slower models and Gemini thinking tokens.
AIRA_REQUEST_TIMEOUT_SECONDS=120
AIRA_STAGE_TIMEOUT_SECONDS=300
AIRA_WORKFLOW_STAGE_TIMEOUT_SECONDS=300
AIRA_MAX_OUTPUT_TOKENS=8192

# --- Optional build guardrails (UTF-8 byte upper bounds for tokens; text is never truncated) ---
# AIRA_BUILD_INPUT_TOKENS bounds each model call, including the single chart-facts call
# (about 25-30 dense chart pages at 60000). Raise it only if your model's context allows.
# AIRA_BUILD_PRIMARY_TOKENS=7000
# AIRA_BUILD_INPUT_TOKENS=60000
# AIRA_BUILD_TOTAL_TOKENS=100000000
# AIRA_BUILD_MAX_CALLS=3000
# AIRA_BUILD_BUILD_TIMEOUT_SECONDS=3600

# Runtime data lives at data/app by default, or $AIRA_DATA_DIR from the process
# environment (not this file).
