# Server-side OpenAI configuration; the shell and CI need no credentials.
OPENAI_API_KEY=
# Set an accessible model after the feasibility check. No tested default yet.
AIRA_MODEL=
# Optional per-stage output budget (1-32768, default 4096); long policies may need more.
# AIRA_MAX_OUTPUT_TOKENS=4096
# Runtime data lives at data/app by default, or $AIRA_DATA_DIR from the process
# environment (not this file).
# Optional OpenAI-compatible endpoint override (e.g. a local LiteLLM proxy).
# OPENAI_BASE_URL=http://127.0.0.1:4000/v1
# Transport: responses (default) or chat_completions for endpoints without /v1/responses.
# AIRA_LLM_TRANSPORT=chat_completions
# Optional per-request and per-stage deadlines (seconds); raise for slower endpoints.
# AIRA_REQUEST_TIMEOUT_SECONDS=30
# AIRA_STAGE_TIMEOUT_SECONDS=65
# Workflow-level per-stage deadline (seconds); raise for slower endpoints.
# AIRA_WORKFLOW_STAGE_TIMEOUT_SECONDS=90
