# Direct OpenAI configuration: https://api.openai.com/v1 and Responses API
# OPENAI_API_KEY=your-key-here
# AIRA_MODEL=gpt-4o
# AIRA_LLM_BACKEND=openai

# --- Alternative: Any OpenAI-compatible service (e.g. Ollama, vLLM, Groq, DeepSeek) ---
# To use an OpenAI-compatible endpoint, set OPENAI_BASE_URL and AIRA_MODEL.
# If using a local endpoint (Ollama, vLLM) that requires no key, OPENAI_API_KEY can be left empty.
# Chat completions transport and adaptive fallback for max_tokens/JSON mode are automatic.
#
# Example 1: Local Ollama (run `ollama run llama3.1:8b` or `qwen2.5:14b`)
# OPENAI_BASE_URL=http://localhost:11434/v1
# AIRA_MODEL=llama3.1:8b
# AIRA_LLM_BACKEND=openai_compatible
# Note for Ollama: Default context window is 2048 tokens; for guideline rules, ensure
# your model is configured with a larger context window (e.g. `PARAMETER num_ctx 16384`
# in Modelfile, or pass `--num_ctx 16384`).
# For slower models, use the deadlines that completed the sample guideline:
# AIRA_REQUEST_TIMEOUT_SECONDS=600
# AIRA_STAGE_TIMEOUT_SECONDS=1200
# AIRA_WORKFLOW_STAGE_TIMEOUT_SECONDS=1220
#
# Example 2: Local vLLM
# OPENAI_BASE_URL=http://localhost:8000/v1
# AIRA_MODEL=meta-llama/Llama-3.1-8B-Instruct
# AIRA_LLM_BACKEND=openai_compatible
#
# Example 3: Groq (high speed cloud API)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# AIRA_MODEL=llama-3.3-70b-versatile
# AIRA_LLM_BACKEND=openai_compatible
#
# Example 4: DeepSeek API
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-...
# AIRA_MODEL=deepseek-chat
# AIRA_LLM_BACKEND=openai_compatible
#
# Example 5: LiteLLM or OpenRouter Proxy
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# AIRA_MODEL=anthropic/claude-3.5-sonnet
# AIRA_LLM_BACKEND=litellm

# Only this block is active. python-dotenv keeps the last assignment, so do not
# add another OPENAI_API_KEY or AIRA_MODEL below these lines.
# Leave the key empty until you set one. For the sample guideline on a slower
# model, uncomment the 600/1200/1220 deadlines. The code defaults are 30/65/90.
OPENAI_API_KEY=
AIRA_MODEL=
AIRA_LLM_BACKEND=openai
# OPENAI_BASE_URL=http://127.0.0.1:4000/v1
# AIRA_LLM_TRANSPORT=chat_completions
# AIRA_LLM_BACKEND=litellm reads OPENAI_BASE_URL from the process environment
# when this file does not set it. That selection still requires a URL.
# AIRA_REQUEST_TIMEOUT_SECONDS=600
# AIRA_STAGE_TIMEOUT_SECONDS=1200
# AIRA_WORKFLOW_STAGE_TIMEOUT_SECONDS=1220
# Optional build guardrails (UTF-8 byte upper bounds for tokens, never truncation).
# AIRA_BUILD_PRIMARY_TOKENS=7000
# AIRA_BUILD_INPUT_TOKENS=60000
# AIRA_BUILD_TOTAL_TOKENS=100000000
# AIRA_BUILD_MAX_CALLS=3000
# AIRA_BUILD_BUILD_TIMEOUT_SECONDS=3600
